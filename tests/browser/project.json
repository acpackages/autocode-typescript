{
  "name": "test-browser",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "tests/browser",
  "tags": [],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx ../../packages/runtime/ac-runtime-cli/src/cli.ts serve --open --port 3000",
        "cwd": "tests/browser"
      }
    },
    "serve-t": {
      "executor": "@nx/vite:dev-server",
      "options": {
        "buildTarget": "test-browser:build"
      }
    },
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/tests/browser",
        "configFile": "tests/browser/vite.config.ts"
      }
    },
    "preview": {
      "executor": "@nx/vite:preview",
      "options": {
        "buildTarget": "test-browser:build"
      }
    },
    "dev-server": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx ../../packages/runtime/ac-runtime-cli/src/cli.ts serve --open --port 3000",
        "cwd": "tests/browser"
      }
    }
  }
}
