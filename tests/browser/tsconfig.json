{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@autocode-ts/ac-browser": ["../../packages/browser/ac-browser/src/index.ts"],
      "@autocode-ts/ac-runtime": ["../../packages/browser/ac-runtime/src/index.ts"],
      "@autocode-ts/autocode": ["../../packages/core/autocode/src/index.ts"],
      "@autocode-ts/ac-data-dictionary-editor": ["../../packages/browser/ac-data-dictionary-editor/src/index.ts"],
      "@autocode-ts/ac-data-dictionary-components": ["../../packages/browser/ac-data-dictionary-components/src/ac-data-dictionary-components.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
